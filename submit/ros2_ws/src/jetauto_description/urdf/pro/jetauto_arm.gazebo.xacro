<?xml version="1.0" encoding="utf-8" ?>
<robot name="jetauto_arm" xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- JointPositionController for arm joints (joint1-joint4) and gripper (r_joint) -->
    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>joint1</joint_name>
            <use_velocity_commands>true</use_velocity_commands>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>joint2</joint_name>
            <use_velocity_commands>true</use_velocity_commands>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>joint3</joint_name>
            <use_velocity_commands>true</use_velocity_commands>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>joint4</joint_name>
            <use_velocity_commands>true</use_velocity_commands>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>r_joint</joint_name>
            <use_velocity_commands>true</use_velocity_commands>
        </plugin>
    </gazebo>

    <!-- DiffDrive for mobile base -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>wheel_left_front_joint</left_joint>
            <right_joint>wheel_right_front_joint</right_joint>
            <wheel_separation>0.17225</wheel_separation>
            <wheel_radius>0.049</wheel_radius>
            <odom_publish_frequency>20.0</odom_publish_frequency>
            <topic>/cmd_vel</topic>
            <odom_topic>/model/jetauto/odometry</odom_topic>
        </plugin>
    </gazebo>

    <!-- JointStatePublisher (respects URDF mimic tags for gripper) -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        </plugin>
    </gazebo>

    <xacro:macro name="model_color" params="link_name color_name">
        <gazebo reference="${link_name}">
            <material>Gazebo/${color_name}</material>
            <turnGravityOff>false</turnGravityOff>
        </gazebo>
    </xacro:macro>

    <xacro:model_color link_name="link1"                color_name="green"/>
    <xacro:model_color link_name="servo_link"           color_name="black"/>
    <xacro:model_color link_name="link2"                color_name="green"/>
    <xacro:model_color link_name="link3"                color_name="green"/>
    <xacro:model_color link_name="link4"                color_name="green"/>
    <xacro:model_color link_name="gripper_servo_link"   color_name="black"/>
</robot>
